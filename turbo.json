{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_WEB_ORIGIN", "UCONEXT_BUILD_ID"],
      "outputs": ["dist/**", ".next/**"]
    }
  }
}
